{
  "name": "doet",
  "version": "0.1.0",
  "description": "Run coding agents together in co-code mode or compare isolated implementations in vs mode.",
  "type": "module",
  "bin": {
    "doet": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "DOET_HOME=\"$HOME/.doet-dev\" tsx src/cli.tsx",
    "build": "tsc && chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "cli",
    "agents",
    "claude-code",
    "codex",
    "harness"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.224",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.10",
    "typescript": "^5.9.3"
  }
}
