{
  "name": "doet",
  "version": "0.1.0",
  "description": "Run two coding agents on the same task in isolated git worktrees, side by side in real terminals, and compare what they produce.",
  "type": "module",
  "bin": {
    "doet": "./dist/doet.mjs"
  },
  "main": "./dist/doet.mjs",
  "files": [
    "dist/doet.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "DOET_HOME=\"$HOME/.doet-dev\" tsx src/cli.tsx",
    "build:tsc": "tsc",
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run build:tsc && npm run bundle",
    "start": "node dist/doet.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/run.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "keywords": [
    "cli",
    "agents",
    "claude-code",
    "codex",
    "tmux",
    "worktree"
  ],
  "license": "MIT",
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.10",
    "typescript": "^5.9.3"
  },
  "os": [
    "darwin",
    "linux"
  ]
}
